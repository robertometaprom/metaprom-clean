# Metaprom environment template — copy to .env.local and fill real values.
# Do not invent Stripe IDs. Test and Live objects are separate; use IDs from the active mode.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (Stripe Test or Live, selected by the configured key) ---
# Set to "stripe" for Stripe checkout. Keep "mock" for local UI without Stripe.
PAYMENT_PROVIDER=mock

# Stripe Dashboard → Developers → API keys → Secret key (sk_test_ or sk_live_)
STRIPE_SECRET_KEY=

# Stripe Dashboard → Developers → Webhooks → Signing secret (must start with whsec_)
STRIPE_WEBHOOK_SECRET=

# Legacy studio SKU — retired. Studio HD checkout uses commercial_1 (V1).
# Do NOT set or reuse this for V1 packages.
# STRIPE_PRICE_ID_COMMERCIAL_VIDEO=

# --- V1 package catalog Price IDs (active Stripe mode, one-time MXN) ---
# /planes + Studio HD checkout resolve Prices from these env vars only.
# Never invent IDs. Never reuse a deleted legacy MXN $149 Price.
STRIPE_PRICE_ID_COMMERCIAL_1=
STRIPE_PRICE_ID_COMMERCIAL_5=
STRIPE_PRICE_ID_COMMERCIAL_10=
STRIPE_PRICE_ID_COMMERCIAL_20=
STRIPE_PRICE_ID_ASSETS_10=
STRIPE_PRICE_ID_ASSETS_25=
STRIPE_PRICE_ID_ASSETS_50=
STRIPE_PRICE_ID_ASSETS_100=

# --- Membership recurring Price IDs (active Stripe mode, MXN subscriptions) ---
# Do not reuse one-off package Price IDs. Create recurring Prices, then set these.
STRIPE_PRICE_ID_GOLDEN_MONTHLY=
STRIPE_PRICE_ID_GOLDEN_ANNUAL=
STRIPE_PRICE_ID_PREMIUM_MONTHLY=
STRIPE_PRICE_ID_PREMIUM_ANNUAL=

# Server-only HMAC for welcome Advertising Image anti-abuse network keys (min 32 chars). Never expose to client.
WELCOME_ABUSE_HMAC_SECRET=

# --- TikTok Pixel + Events API (observability only; never blocks product flows) ---
# Public Pixel ID. Safe to expose to the browser.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Optional server-only Pixel ID if it must differ from the public value.
# TIKTOK_PIXEL_ID=
# Server-only Events API access token. Never use NEXT_PUBLIC_*. Never commit the real token.
TIKTOK_EVENTS_API_ACCESS_TOKEN=

# --- Support mail (Vercel Resend integration in Production/Preview) ---
# Server-only. Never use NEXT_PUBLIC_*.
# RESEND_API_KEY=
# RESEND_EMAIL_DOMAIN=
