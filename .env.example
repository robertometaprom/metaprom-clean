# Metaprom environment template — copy to .env.local and fill real values.
# Do not invent Stripe IDs. Create them in Stripe Dashboard (Test Mode).

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (Stripe Test Mode only) ---
# Set to "stripe" for Test Mode checkout. Keep "mock" for local UI without Stripe.
PAYMENT_PROVIDER=mock

# Stripe Dashboard → Developers → API keys → Secret key (must start with sk_test_)
STRIPE_SECRET_KEY=

# Stripe Dashboard → Developers → Webhooks → Signing secret (must start with whsec_)
STRIPE_WEBHOOK_SECRET=

# Stripe Dashboard → Product catalog → Price ID for commercial HD (must start with price_)
# Create: Product "Metaprom comercial HD" → one-time Price 149 MXN → copy price_...
STRIPE_PRICE_ID_COMMERCIAL_VIDEO=
