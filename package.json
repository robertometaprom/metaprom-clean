{
  "name": "metaprom-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "admin:grant": "node --env-file=.env.local scripts/admin-grant-entitlement.mjs",
    "test:creative-recipe": "tsx --test tests/creative-recipe.test.ts",
    "test:commercial-fidelity": "tsx --test tests/studio-prompts.test.ts",
    "test:commercial-persistence": "node --experimental-strip-types --test tests/commercial-persistence-rescue.test.ts",
    "test:video-processing": "tsx --test tests/video-processing-command.test.ts",
    "test:admin-grants": "tsx --test tests/admin-test-credits.test.ts",
    "test:production-router": "tsx --tsconfig tests/tsconfig.phase1.json --test tests/production-router-phase1.test.ts",
    "test:generation-events": "tsx --tsconfig tests/tsconfig.generation-events.json --test tests/generation-events.test.ts",
    "test:video-repair": "tsx --tsconfig tests/tsconfig.video-repair.json --test tests/video-repair.test.ts",
    "test:video-public-auth": "tsx --tsconfig tests/tsconfig.video-public-auth.json --test tests/video-public-auth.test.ts",
    "test:share-launch": "tsx --test tests/share-launch.test.ts",
    "test:seo": "tsx --test tests/seo-foundation.test.ts",
    "test:closed-production-surfaces": "tsx --test tests/closed-production-surfaces.test.ts",
    "test:gtm4": "tsx --test tests/gtm4-ux-navigation.test.ts",
    "test:gtm5": "tsx --test tests/gtm5-commercial-message.test.ts",
    "test:gtm52": "tsx --tsconfig tests/tsconfig.gtm52.json --test --test-concurrency=1 tests/gtm52-support.test.ts",
    "test:gtm53": "tsx --test tests/gtm53-premium-guarantee.test.ts",
    "test:checkout-integrity": "tsx --tsconfig tests/tsconfig.stripe-payment.json --test tests/checkout-integrity.test.ts",
    "test:membership-phase1": "tsx --tsconfig tests/tsconfig.stripe-payment.json --test tests/membership-stripe-phase1.test.ts tests/planes-membership-offer.test.ts",
    "test:antiabuse": "tsx --tsconfig tests/tsconfig.antiabuse.json --test tests/antiabuse-cost-control.test.ts",
    "test:analytics": "tsx --test tests/analytics-funnel.test.ts tests/analytics-dashboard.test.ts",
    "test:analytics-dashboard": "tsx --test tests/analytics-dashboard.test.ts",
    "test:tiktok": "tsx --tsconfig tests/tsconfig.stripe-payment.json --test tests/tiktok-tracking.test.ts",
    "test:generation-v2": "tsx --tsconfig tests/tsconfig.generation-v2.json --test tests/generation-v2/pipeline-phase1.test.ts",
    "test:generation-v2:workflow": "vitest run --config vitest.generation-v2.workflow.config.ts",
    "test:generation-v2:workflow-correctness": "vitest run --config vitest.generation-v2.workflow.config.ts tests/generation-v2/pipeline-phase1.workflow-correctness.test.ts",
    "test:generation-v2:workflow-stress": "vitest run --config vitest.generation-v2.workflow.config.ts tests/generation-v2/pipeline-phase1.workflow-stress.test.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@google/genai": "^2.9.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.40.0",
    "lean-qr": "^2.7.2",
    "next": "16.2.6",
    "openai": "^6.39.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.20.0",
    "sharp": "0.34.5",
    "stripe": "^22.3.1",
    "workflow": "^4.8.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workflow/vitest": "^4.0.21",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
